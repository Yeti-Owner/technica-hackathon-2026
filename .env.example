# TEMPLATE - this file IS committed. Copy it to ".env" and fill real values there.
# LOCAL SECRETS - this file is gitignored. DO NOT COMMIT. DO NOT SHARE.
# Fill in: replace the text INSIDE the quotes of each line below.
# Spaces and quotes around values are tolerated (they get stripped).
# After editing, restart the browser app (python run.py) to load values.
# =====================================================================

# ---------------------------------------------------------------
# Used by the browser itself, every time you browse (AI image check)
# ---------------------------------------------------------------

# Server address of the Vultr "AI image check" box, WITH http://.
# It serves plain HTTP on port 80, so the correct form is:
#     http://<the-Vultr-IPv4>
# Example shape (not a real address): http://203.0.113.7
AI_CHECK_SERVER_URL = "PUT VULTR URL HERE like http://203.0.113.7"

# The access key the server checks in the X-API-Key header.
# It is the long 48-character hex string stored on the Vultr box in
# /root/ai-check/config.json under the name "api_key".
AI_CHECK_API_KEY = "PUT HEX API KEY HERE"

# ---------------------------------------------------------------
# Used ONLY by tools/vultr_patch.py: one-time SSH hardening patch.
# The browser never reads these.
# ---------------------------------------------------------------

# The same Vultr IPv4, WITHOUT http:// this time. Bare IP only.
VULTR_SSH_HOST = "PUT BARE VULTR IP HERE"

# SSH login user on the Vultr box. The runbook says: root.
VULTR_SSH_USER = "PUT SSH USERNAME HERE"

# SSH password for that login.
VULTR_SSH_PASSWORD = "PUT SSH PASSWORD HERE"
